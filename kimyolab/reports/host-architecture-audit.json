    "exists": true,
    "importedBy": [
      "src/app/bootstrap.ts"
    ],
    "onlyBootstrapImports": true,
    "bootstrapUsesHost": {
      "resolveHost": true,
      "contentBase": true,
      "fetchContent": true,
      "storage": true,
      "locks": true,
      "links": true
    }
  },
  "hardcodedPaths": {
    "patterns": [
      {
        "id": "content-root-literal",
        "description": "a content URL hard-coded to /content",
        "allowIn": [
          "src/app/host.ts"
        ]
      },
      {
        "id": "app-preview-root-literal",
        "description": "a module/CSS URL hard-coded to /app-preview/",
        "allowIn": []
      },
      {
        "id": "asset-root-literal",
        "description": "an asset URL hard-coded to /assets/ or /vendor/",
        "allowIn": []
      },
      {
        "id": "api-root-literal",
        "description": "an API URL hard-coded to /api/",
        "allowIn": [
          "src/app/host.ts"
        ]
      },
      {
        "id": "location-or-history-write",
        "description": "navigation state written outside the host boundary",
        "allowIn": [
          "src/app/host.ts"
        ]
      },
      {
        "id": "host-type-check",
        "description": "code that inspects which host it runs in",
        "allowIn": [
          "src/app/host.ts"
        ]
      }
    ],
    "after": {
