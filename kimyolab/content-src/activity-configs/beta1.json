  "practice.experiment.7.3": {
    "type": "experiment",
    "version": "1.0.0",
    "conceptId": "concept.c014",
    "scenario": {
      "id": "beta1.7.05.procedure",
      "steps": [
        {
          "id": "step-1",
          "actionType": "step.1",
          "label": "Siyoh dog‘ini tozalashning 1-usuli: dog‘ ustiga oq tish pastasini surting, eski tish cho‘tkasi bilan aylana harakatda ishqalang va issiq suv bilan yuving."
        },
        {
          "id": "step-2",
          "actionType": "step.2",
          "label": "Siyoh dog‘ini tozalashning 2-usuli: dog‘ni spirt bilan namlang, biroz kuting, ishqalang va kir sovuni yoki idish yuvish vositasi bilan yuving."
        },
        {
          "id": "step-3",
          "actionType": "step.3",
          "label": "Ko‘mirning yonishini kuzatish: no‘xat kattaligidagi ko‘mir bo‘lagini qoshiqda qizdiring, cho‘g‘langan ko‘mirni chinni kosachaga tushiring va yonish jarayonini kuzating."
        },
        {
          "id": "step-4",
          "actionType": "step.4",
          "label": "Temirning zanglashini taqqoslash uchun 4 ta stakan tayyorlang: 1-stakan — suv va mix; 2-stakan — suv, mix va osh tuzi; 3-stakan — suv, mix va mis plastinka; 4-stakan — suv, mix va rux plastinka. Vaqt o‘tishi bilan o‘zgarishlarni taqqoslang."
        }
      ]
    },
    "safetyNotes": [],
    "virtualOnly": true
  },
