  "practice.experiment.7.7": {
    "type": "experiment",
    "version": "1.0.0",
    "conceptId": "concept.c054",
    "scenario": {
      "id": "beta1.7.19.procedure",
      "steps": [
        {
          "id": "step-1",
          "actionType": "step.1",
          "label": "Spirt lampani yoqing va alangani to‘g‘ri o‘chiring. Alanganing pastki, o‘rta va yuqori qismlarini kuzating."
        },
        {
          "id": "step-2",
          "actionType": "step.2",
          "label": "Kislorod olish uchun probirkaning 1/3 qismiga kaliy permanganat soling, gaz o‘tkazgichli apparatni yig‘ing va probirkani ehtiyotkor qizdiring. Kislorodni suvni siqib chiqarish usulida yig‘ing."
        },
        {
          "id": "step-3",
          "actionType": "step.3",
          "label": "Cho‘g‘langan ko‘mirni kislorodli idishga tushiring, yonishni kuzating, so‘ng ohakli suv solib chayqating."
        },
        {
          "id": "step-4",
          "actionType": "step.4",
          "label": "Oltingugurtni temir qoshiqchada yondiring va kislorodli idishga tushiring. Kuzatuv va tenglamani qayd qiling."
        },
        {
          "id": "step-5",
          "actionType": "step.5",
          "label": "Spiral shakldagi temir simni qizdiring va tubiga qum solingan kislorodli idishga tushiring. Uchqunlanish va hosil bo‘lgan mahsulotni kuzating."
        }
      ]
    },
    "safetyNotes": [
      "Kislorodli idish tubiga temir sim tajribasida qum soling. Idish sinishining oldi olinadi."
    ],
    "virtualOnly": true
  },
  "practice.experiment.7.8": {
    "type": "experiment",
    "version": "1.0.0",
    "conceptId": "concept.c059",
    "scenario": {
      "id": "beta1.7.20.procedure",
      "steps": [
        {
          "id": "step-1",
          "actionType": "step.1",
          "label": "Apparatga 2–3 bo‘lak metall soling, mahkam yoping va zichligini tekshiring."
        },
        {
          "id": "step-2",
          "actionType": "step.2",
          "label": "2–3 ml suyultirilgan kislota qo‘shing. Gaz ajralishini kuzating."
        },
        {
          "id": "step-3",
          "actionType": "step.3",
          "label": "Vodorodni suv yoki havoni siqib chiqarish usulida yig‘ing."
        },
        {
          "id": "step-4",
          "actionType": "step.4",
          "label": "Gazning tozaligini kichik porsiyada tekshiring: sof vodorod sokin yonadi, havo bilan aralashma esa “paq” etib ovoz chiqaradi."
        },
        {
          "id": "step-5",
          "actionType": "step.5",
          "label": "Yonayotgan cho‘pni vodorodli idishga kiriting va alangani kuzating."
        },
        {
          "id": "step-6",
          "actionType": "step.6",
          "label": "Vodorodni yoqing, alanga ustida shisha plastinka tuting va hosil bo‘lgan suv tomchilarini kuzating."
        },
        {
          "id": "step-7",
          "actionType": "step.7",
          "label": "Vodorod bilan sovun pufakchalarini hosil qilib, uning havodan yengil ekanini kuzating."
        },
        {
          "id": "step-8",
          "actionType": "step.8",
          "label": "Vodorodni qizdirilgan CuO ustidan o‘tkazing. Qizil mis va suv hosil bo‘lishini kuzating."
        }
      ]
    },
    "safetyNotes": [
      "Vodorodning tozaligini katta hajmda emas, kichik porsiyada tekshiring."
    ],
    "virtualOnly": true
  },
