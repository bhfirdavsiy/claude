{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kimyolab.local/schemas/common.schema.json",
  "title": "KimyoLab shared definitions",
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "optionalText": {
      "type": "string"
    },
    "conceptId": {
      "type": "string",
      "pattern": "^concept\\.c[0-9]{3,}$"
    },
    "learningUnitId": {
      "type": "string",
      "pattern": "^lu\\.(7|8|9|10|11)\\.[0-9]+(\\.[0-9]+)*$"
    },
    "theoryId": {
      "type": "string",
      "pattern": "^theory\\.[0-9]+(\\.[0-9]+)+$"
    },
    "practiceId": {
      "type": "string",
      "pattern": "^practice\\.(experiment|simulation|trainer|calculation|case)\\.[0-9]+(\\.[0-9]+)+(\\.[a-z][a-z0-9-]*)?$"
    },
    "mappingId": {
      "type": "string",
      "pattern": "^mapping\\.[0-9]+(\\.[0-9]+)+\\.(primary|supporting|remediation|extension)(\\.[0-9]{2})?$"
    },
    "misconceptionId": {
      "type": "string",
      "pattern": "^misconception\\.[a-z0-9.-]+$"
    },
    "legacyId": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)+$"
    },
    "grade": {
      "enum": [
        7,
        8,
        9,
        10,
        11
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)*(-[A-Za-z0-9.]+)?$"
    },
    "isoDateOrEmpty": {
      "type": "string",
      "anyOf": [
        {
          "const": ""
        },
        {
          "format": "date-time"
        }
      ]
    },
    "sha256OrEmpty": {
      "type": "string",
      "pattern": "^([a-f0-9]{64})?$"
    },
    "representation": {
      "enum": [
        "macro",
        "micro",
        "symbolic"
      ]
    },
    "lifecycleStatus": {
      "enum": [
        "draft",
        "planned",
        "in_progress",
        "implemented",
        "ready",
        "deprecated"
      ]
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "title"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "internal",
            "textbook",
            "external",
            "legacy"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "license": {
          "type": "string"
        }
      }
    },
    "approvalRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reviewerId",
        "reviewerRole",
        "reviewedVersion",
        "reviewedHash",
        "reviewedAt"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "approved",
            "rejected"
          ]
        },
        "reviewerId": {
          "type": "string",
          "minLength": 1
        },
        "reviewerRole": {
          "enum": [
            "technical",
            "chemistry",
            "didactic",
            "accessibility"
          ]
        },
        "reviewedVersion": {
          "type": "string"
        },
        "reviewedHash": {
          "$ref": "#/$defs/sha256OrEmpty"
        },
        "reviewedAt": {
          "$ref": "#/$defs/isoDateOrEmpty"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "approvals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "technical",
        "chemistry",
        "didactic",
        "accessibility"
      ],
      "properties": {
        "technical": {
          "$ref": "#/$defs/approvalRecord"
        },
        "chemistry": {
          "oneOf": [
            {
              "const": "not_applicable"
            },
            {
              "$ref": "#/$defs/approvalRecord"
            }
          ]
        },
        "didactic": {
          "$ref": "#/$defs/approvalRecord"
        },
        "accessibility": {
          "$ref": "#/$defs/approvalRecord"
        }
      }
    }
  }
}
