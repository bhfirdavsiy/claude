    },
    "curriculumVersion": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "string"
    },
    "chemistryRulesVersion": {
      "type": "string"
    },
    "assessmentVersion": {
      "type": "string"
    },
    "scoringVersion": {
      "type": "string"
    },
    "createdAt": {
      "type": "string"
    },
    "checksum": {
      "type": "string"
    },
    "compatibility": {
      "type": "object"
    },
    "grades": {
      "type": "array",
