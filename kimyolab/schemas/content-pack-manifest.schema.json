{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kimyolab.local/schemas/content-pack-manifest.schema.json",
  "title": "ContentPackManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contentVersion",
    "curriculumVersion",
    "schemaVersion",
    "chemistryRulesVersion",
    "assessmentVersion",
    "scoringVersion",
    "createdAt",
    "checksum",
    "compatibility",
    "grades",
    "files"
  ],
  "properties": {
    "contentVersion": {
      "type": "string",
      "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]+$"
    },
    "curriculumVersion": {
      "$ref": "common.schema.json#/$defs/version"
    },
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/version"
    },
    "chemistryRulesVersion": {
      "$ref": "common.schema.json#/$defs/version"
    },
    "assessmentVersion": {
      "$ref": "common.schema.json#/$defs/version"
    },
    "scoringVersion": {
      "$ref": "common.schema.json#/$defs/version"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "checksum": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minAppVersion"
      ],
      "properties": {
        "minAppVersion": {
          "$ref": "common.schema.json#/$defs/version"
        },
        "maxAppVersion": {
          "$ref": "common.schema.json#/$defs/version"
        }
      }
    },
    "grades": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/grade"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "evidenceCompatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "content": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "compatible",
              "recalculable",
              "incompatible"
            ]
          }
        },
        "scoring": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "compatible",
              "recalculable",
              "incompatible"
            ]
          }
        },
        "curriculum": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "compatible",
              "recalculable",
              "incompatible"
            ]
          }
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "checksum",
          "size"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9./-]*\\.(json|yaml)$",
            "not": {
              "pattern": "\\.\\."
            }
          },
          "checksum": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "minItems": 1
    }
  }
}
