{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kimyolab.local/schemas/structured-theory.schema.json",
  "title": "StructuredTheory",
  "description": "P2.3 (ADR-P2-004): human-authored, source-supported structured theory of one learning unit. Every block carries its own provenance and review state. The build additionally enforces explanation length, registered/acceptable sources, no placeholders, no automation authors and hash-pinned approvals.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "theoryId",
    "learningUnitId",
    "version",
    "explanation",
    "workedExamples",
    "misconceptions",
    "summary"
  ],
  "properties": {
    "schema": {
      "const": "kimyolab.structured-theory.v1"
    },
    "theoryId": {
      "$ref": "common.schema.json#/$defs/theoryId"
    },
    "learningUnitId": {
      "type": "string",
      "pattern": "^lu\\.(7|8|9|10|11)\\.[A-Za-z0-9.-]+$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "explanation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "sourceRefs",
        "authoredBy",
        "reviewStatus"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 300
        },
        "sourceRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "authoredBy": {
          "type": "string",
          "minLength": 1
        },
        "reviewStatus": {
          "enum": [
            "draft",
            "pending-review",
            "changes-requested",
            "approved"
          ]
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reviewerId",
            "reviewerRole",
            "reviewedAt",
            "reviewedHash"
          ],
          "properties": {
            "reviewerId": {
              "type": "string",
              "minLength": 1
            },
            "reviewerRole": {
              "enum": [
                "chemistry",
                "didactic"
              ]
            },
            "reviewedAt": {
              "type": "string",
              "format": "date-time"
            },
            "reviewedHash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      },
      "if": {
        "properties": {
          "reviewStatus": {
            "const": "approved"
          }
        }
      },
      "then": {
        "required": [
          "review"
        ]
      }
    },
    "workedExamples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "problem",
          "solutionSteps",
          "answer",
          "sourceRefs",
          "authoredBy",
          "reviewStatus"
        ],
        "properties": {
          "problem": {
            "type": "string",
            "minLength": 1
          },
          "solutionSteps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "answer": {
            "type": "string",
            "minLength": 1
          },
          "sourceRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "authoredBy": {
            "type": "string",
            "minLength": 1
          },
          "reviewStatus": {
            "enum": [
              "draft",
              "pending-review",
              "changes-requested",
              "approved"
            ]
          },
          "review": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reviewerId",
              "reviewerRole",
              "reviewedAt",
              "reviewedHash"
            ],
            "properties": {
              "reviewerId": {
                "type": "string",
                "minLength": 1
              },
              "reviewerRole": {
                "enum": [
                  "chemistry",
                  "didactic"
                ]
              },
              "reviewedAt": {
                "type": "string",
                "format": "date-time"
              },
              "reviewedHash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        },
        "if": {
          "properties": {
            "reviewStatus": {
              "const": "approved"
            }
          }
        },
        "then": {
          "required": [
            "review"
          ]
        }
      }
    },
    "misconceptions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "statement",
          "correction",
          "sourceRefs",
          "authoredBy",
          "reviewStatus"
        ],
        "properties": {
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "correction": {
            "type": "string",
            "minLength": 1
          },
          "sourceRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "authoredBy": {
            "type": "string",
            "minLength": 1
          },
          "reviewStatus": {
            "enum": [
              "draft",
              "pending-review",
              "changes-requested",
              "approved"
            ]
          },
          "review": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reviewerId",
              "reviewerRole",
              "reviewedAt",
              "reviewedHash"
            ],
            "properties": {
              "reviewerId": {
                "type": "string",
                "minLength": 1
              },
              "reviewerRole": {
                "enum": [
                  "chemistry",
                  "didactic"
                ]
              },
              "reviewedAt": {
                "type": "string",
                "format": "date-time"
              },
              "reviewedHash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        },
        "if": {
          "properties": {
            "reviewStatus": {
              "const": "approved"
            }
          }
        },
        "then": {
          "required": [
            "review"
          ]
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "points",
        "sourceRefs",
        "authoredBy",
        "reviewStatus"
      ],
      "properties": {
        "points": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sourceRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "authoredBy": {
          "type": "string",
          "minLength": 1
        },
        "reviewStatus": {
          "enum": [
            "draft",
            "pending-review",
            "changes-requested",
            "approved"
          ]
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reviewerId",
            "reviewerRole",
            "reviewedAt",
            "reviewedHash"
          ],
          "properties": {
            "reviewerId": {
              "type": "string",
              "minLength": 1
            },
            "reviewerRole": {
              "enum": [
                "chemistry",
                "didactic"
              ]
            },
            "reviewedAt": {
              "type": "string",
              "format": "date-time"
            },
            "reviewedHash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      },
      "if": {
        "properties": {
          "reviewStatus": {
            "const": "approved"
          }
        }
      },
      "then": {
        "required": [
          "review"
        ]
      }
    },
    "media": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "src",
          "alt",
          "sourceRefs"
        ],
        "properties": {
          "src": {
            "type": "string",
            "pattern": "^assets/theory/[A-Za-z0-9._/-]+\\.(png|webp|svg|jpg)$"
          },
          "alt": {
            "type": "string",
            "minLength": 1
          },
          "caption": {
            "type": "string",
            "minLength": 1
          },
          "sourceRefs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
