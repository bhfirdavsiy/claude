{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kimyolab.local/schemas/structured-theory.schema.json",
  "title": "StructuredTheory",
  "description": "P2.3 (ADR-P2-004): human-authored, source-supported structured theory of one learning unit. Every block carries its own provenance and reviews. APPROVED is derived: an approving chemistry review and an approving didactic review by two distinct humans (neither the author), both pinned to the block's current content hash. The build additionally enforces explanation length, registered/acceptable sources, no placeholders and no automation identities.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "theoryId",
    "learningUnitId",
    "version",
    "explanation",
    "workedExamples",
    "misconceptions",
    "summary"
  ],
  "properties": {
    "schema": {
      "const": "kimyolab.structured-theory.v1"
    },
    "theoryId": {
      "$ref": "common.schema.json#/$defs/theoryId"
    },
    "learningUnitId": {
      "type": "string",
      "pattern": "^lu\\.(7|8|9|10|11)\\.[A-Za-z0-9.-]+$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "explanation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "sourceRefs",
        "authoredBy",
        "status",
        "reviews"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 300
        },
        "sourceRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "authoredBy": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "draft",
            "ready-for-review"
          ],
          "description": "the author's workflow state; approval is DERIVED from reviews, never authored"
        },
        "reviews": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reviewerId",
              "reviewerRole",
              "decision",
              "reviewedAt",
              "reviewedHash"
            ],
            "properties": {
              "reviewerId": {
                "type": "string",
                "minLength": 1
              },
              "reviewerRole": {
                "enum": [
                  "chemistry",
                  "didactic"
                ]
              },
              "decision": {
                "enum": [
                  "approved",
                  "changes-requested"
                ]
              },
              "reviewedAt": {
                "type": "string",
                "format": "date-time"
              },
              "reviewedHash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "notes": {
                "type": "string"
              }
            }
          },
          "maxItems": 8
        }
      }
    },
    "workedExamples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "problem",
          "solutionSteps",
          "answer",
          "sourceRefs",
          "authoredBy",
          "status",
          "reviews"
        ],
        "properties": {
          "problem": {
            "type": "string",
            "minLength": 1
          },
          "solutionSteps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "answer": {
            "type": "string",
            "minLength": 1
          },
          "sourceRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "authoredBy": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "draft",
              "ready-for-review"
            ],
            "description": "the author's workflow state; approval is DERIVED from reviews, never authored"
          },
          "reviews": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "reviewerId",
                "reviewerRole",
                "decision",
                "reviewedAt",
                "reviewedHash"
              ],
              "properties": {
                "reviewerId": {
                  "type": "string",
                  "minLength": 1
                },
                "reviewerRole": {
                  "enum": [
                    "chemistry",
                    "didactic"
                  ]
                },
                "decision": {
                  "enum": [
                    "approved",
                    "changes-requested"
                  ]
                },
                "reviewedAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "reviewedHash": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "notes": {
                  "type": "string"
                }
              }
            },
            "maxItems": 8
          }
        }
      }
    },
    "misconceptions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "statement",
          "correction",
          "sourceRefs",
          "authoredBy",
          "status",
          "reviews"
        ],
        "properties": {
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "correction": {
            "type": "string",
            "minLength": 1
          },
          "sourceRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "authoredBy": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "draft",
              "ready-for-review"
            ],
            "description": "the author's workflow state; approval is DERIVED from reviews, never authored"
          },
          "reviews": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "reviewerId",
                "reviewerRole",
                "decision",
                "reviewedAt",
                "reviewedHash"
              ],
              "properties": {
                "reviewerId": {
                  "type": "string",
                  "minLength": 1
                },
                "reviewerRole": {
                  "enum": [
                    "chemistry",
                    "didactic"
                  ]
                },
                "decision": {
                  "enum": [
                    "approved",
                    "changes-requested"
                  ]
                },
                "reviewedAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "reviewedHash": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "notes": {
                  "type": "string"
                }
              }
            },
            "maxItems": 8
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "points",
        "sourceRefs",
        "authoredBy",
        "status",
        "reviews"
      ],
      "properties": {
        "points": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sourceRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "authoredBy": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "draft",
            "ready-for-review"
          ],
          "description": "the author's workflow state; approval is DERIVED from reviews, never authored"
        },
        "reviews": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reviewerId",
              "reviewerRole",
              "decision",
              "reviewedAt",
              "reviewedHash"
            ],
            "properties": {
              "reviewerId": {
                "type": "string",
                "minLength": 1
              },
              "reviewerRole": {
                "enum": [
                  "chemistry",
                  "didactic"
                ]
              },
              "decision": {
                "enum": [
                  "approved",
                  "changes-requested"
                ]
              },
              "reviewedAt": {
                "type": "string",
                "format": "date-time"
              },
              "reviewedHash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "notes": {
                "type": "string"
              }
            }
          },
          "maxItems": 8
        }
      }
    },
    "media": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "src",
          "alt",
          "sourceRefs"
        ],
        "properties": {
          "src": {
            "type": "string",
            "pattern": "^assets/theory/[A-Za-z0-9._/-]+\\.(png|webp|svg|jpg)$"
          },
          "alt": {
            "type": "string",
            "minLength": 1
          },
          "caption": {
            "type": "string",
            "minLength": 1
          },
          "sourceRefs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
