  "practice.experiment.9.1": {
    "type": "experiment",
    "version": "1.0.0",
    "conceptId": "concept.c167",
    "scenario": {
      "id": "beta2.9.09.procedure",
      "steps": [
        {
          "id": "step-1",
          "actionType": "step.1",
          "label": "Probirkaga bo‘r yoki marmar bo‘laklari soling va ozgina suyultirilgan HCl quying."
        },
        {
          "id": "step-2",
          "actionType": "step.2",
          "label": "Probirka og‘zini gaz o‘tkazgich nayli tiqin bilan berkiting."
        },
        {
          "id": "step-3",
          "actionType": "step.3",
          "label": "Gaz nayini 2–3 ml ohakli suv quyilgan probirkaga tushiring va hodisani kuzating."
        },
        {
          "id": "step-4",
          "actionType": "step.4",
          "label": "Gazni distillangan suvdan 1–2 daqiqa o‘tkazing, so‘ng olingan eritmaga ko‘k lakmus tomizing."
        },
        {
          "id": "step-5",
          "actionType": "step.5",
          "label": "NaOH eritmasiga fenolftalein qo‘shing va eritmadan CO2 o‘tkazing."
        },
        {
          "id": "step-6",
          "actionType": "step.6",
          "label": "10 g tuproqni suv bilan aralashtirib filtrlang. Tuproqdan 2–3 g ni HCl bilan tekshiring; filtratga AgNO3 qo‘shing, oq cho‘kmani filtrlab ikki qismga bo‘ling: biriga ammiak yoki suyultirilgan HCl qo‘shing, ikkinchisini qizdiring."
        }
      ]
    },
    "safetyNotes": [],
    "virtualOnly": true
  },
