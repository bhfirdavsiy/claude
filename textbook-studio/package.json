{
  "name": "textbook-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "60-second cinematic textbook animation (React + Three.js + Remotion)",
  "scripts": {
    "verify-assets": "node scripts/verify-assets.mjs",
    "dev": "npm run verify-assets && vite",
    "build": "npm run verify-assets && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "studio": "remotion studio src/remotion/index.ts",
    "render": "node scripts/render.mjs",
    "render:still": "node scripts/render-stills.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@react-three/fiber": "^9.8.2",
    "@remotion/player": "^4.0.536",
    "@remotion/three": "^4.0.536",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.536",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@remotion/bundler": "^4.0.536",
    "@remotion/cli": "^4.0.536",
    "@remotion/renderer": "^4.0.536",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.4"
  }
}
